diff --git a/tests/eflib/test_delta3_ultra.py b/tests/eflib/test_delta3_ultra.py
new file mode 100644
index 0000000..9e198b0
--- /dev/null
+++ b/tests/eflib/test_delta3_ultra.py
@@ -0,0 +1,31 @@
+from unittest.mock import AsyncMock, MagicMock, Mock
+
+import pytest
+
+from custom_components.ef_ble.eflib.devices.delta3_ultra import Device
+from custom_components.ef_ble.eflib.pb import pd335_sys_pb2
+
+
+@pytest.fixture
+def device():
+    ble_dev = Mock()
+    ble_dev.address = "AA:BB:CC:DD:EE:FF"
+    adv_data = MagicMock()
+    device = Device(ble_dev, adv_data, "D751TEST1234")
+    device._conn = AsyncMock()
+    return device
+
+
+def test_delta3_ultra_exposes_storm_guard_telemetry(device):
+    message = pd335_sys_pb2.DisplayPropertyUpload(
+        storm_pattern_enable=True,
+        storm_pattern_open_flag=True,
+        storm_pattern_end_time=1790211640,
+    )
+
+    device.update_from_message(message, reset=True)
+
+    assert device.storm_guard_enabled is True
+    assert device.storm_guard_active is True
+    assert device.storm_guard_end_time == 1790211640
+    assert Device.storm_guard_active.public_name in device.updated_fields
